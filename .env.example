# Database Settings
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_password
POSTGRES_DB=logistics_db
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# MQTT Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional client TLS paths inside the backend/agent container.
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=

# Configure strong, unique values before enabling operator/admin API actions.
API_OPERATOR_TOKEN=
API_ADMIN_TOKEN=
DYNAMIC_AGENT_PROCESS_LIMIT=200

# Keep the default broker on local-development config. For authenticated TLS,
# provide provisioned password/certificate files and select the TLS example.
MOSQUITTO_CONFIG=./mosquitto.conf
MOSQUITTO_PASSWORD_FILE=./mosquitto.passwords.example
MOSQUITTO_ACL_FILE=./mosquitto.acl.example

# Backend Settings
APP_NAME="Decentralized Multi-Agent Coordination Platform"
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
